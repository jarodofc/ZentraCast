{
  "name": "zentracast",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "ZentraCast: minimal IPTV & Web Video Caster web player",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/iptv.test.mjs",
    "check": "npm run test && npm run typecheck"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "hls.js": "1.7.4"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "~5.9.3",
    "vite": "8.3.8"
  }
}
